#!/usr/bin/env python3
# Gestito da Ansible (ruolo sensors) — non modificare a mano.
#
# Legge sentenze NMEA GGA dal GPS, ne estrae posizione e qualita' del fix,
# e le scrive su SQLite in WAL mode con commit raggruppati (non una
# scrittura per lettura) per non consumare la microSD.

import sqlite3
import sys
import time
from datetime import datetime, timezone

import serial

SERIAL_PORT = "{{ gps_serial_port }}"
SERIAL_BAUD = {{ gps_serial_baud }}
DB_PATH = "{{ sensors_db_path }}"
SCHEMA_PATH = "{{ sensors_install_dir }}/schema.sql"

BATCH_SIZE = 20
BATCH_INTERVAL_S = 5.0


def open_db():
    conn = sqlite3.connect(DB_PATH)
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA synchronous=NORMAL")
    with open(SCHEMA_PATH) as f:
        conn.executescript(f.read())
    conn.commit()
    return conn


def nmea_to_decimal(value, direction):
    if not value or not direction:
        return None
    degrees_len = 2 if direction in ("N", "S") else 3
    degrees = float(value[:degrees_len])
    minutes = float(value[degrees_len:])
    decimal = degrees + minutes / 60.0
    if direction in ("S", "W"):
        decimal = -decimal
    return decimal


def parse_gga(fields):
    # $GPGGA,time,lat,N/S,lon,E/W,fix_quality,num_sats,hdop,alt,M,...
    if len(fields) < 8:
        return None
    try:
        fix_quality = int(fields[6]) if fields[6] else 0
        num_sats = int(fields[7]) if fields[7] else 0
    except ValueError:
        return None

    lat = nmea_to_decimal(fields[2], fields[3])
    lon = nmea_to_decimal(fields[4], fields[5])

    ts = datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
    readings = [
        (ts, "gps_fix_quality", float(fix_quality)),
        (ts, "gps_satellites", float(num_sats)),
    ]
    if lat is not None and lon is not None:
        readings.append((ts, "gps_lat", lat))
        readings.append((ts, "gps_lon", lon))
    return readings


def flush_batch(conn, batch):
    conn.executemany(
        "INSERT INTO readings (ts, source, value) VALUES (?, ?, ?)", batch
    )
    conn.commit()
    batch.clear()


def read_loop(conn):
    batch = []
    last_flush = time.monotonic()
    with serial.Serial(SERIAL_PORT, SERIAL_BAUD, timeout=1) as ser:
        while True:
            raw = ser.readline().decode("ascii", errors="ignore").strip()

            if raw.startswith("$GPGGA") or raw.startswith("$GNGGA"):
                fields = raw.split("*")[0].split(",")
                readings = parse_gga(fields)
                if readings:
                    batch.extend(readings)

            now = time.monotonic()
            if batch and (len(batch) >= BATCH_SIZE or now - last_flush >= BATCH_INTERVAL_S):
                flush_batch(conn, batch)
                last_flush = now


def main():
    conn = open_db()
    while True:
        try:
            read_loop(conn)
        except serial.SerialException as exc:
            print(
                f"Errore seriale ({SERIAL_PORT}): {exc}, riconnessione tra 5s",
                file=sys.stderr,
            )
            time.sleep(5)


if __name__ == "__main__":
    main()
